<Standard:Panel caption=" System ">
  <Properties><FillColor>0</FillColor></Properties>
  <Standard:Panel>
    <Properties><Alignment>1</Alignment><Bounds><Width>180</Width></Bounds></Properties>
    <Standard:Button>
      <Properties>
        <Caption>Kernel log</Caption>
        <Alignment>2</Alignment>
        <OnClickHandler>X Run</OnClickHandler>
      </Properties>
      <Standard:SystemCommand>
        <Properties><ID>X</ID>
          <CommandString>WMKernelLog.Open</CommandString>
        </Properties>
      </Standard:SystemCommand>
    </Standard:Button>
    <Standard:Button>
      <Properties>
        <Caption>Shutdown</Caption>
        <Alignment>2</Alignment>
        <OnClickHandler>X Run</OnClickHandler>
      </Properties>
      <Standard:SystemCommand>
        <Properties><ID>X</ID>
          <CommandString>System.PowerDown</CommandString>
        </Properties>
      </Standard:SystemCommand>
    </Standard:Button>
  </Standard:Panel>
  <Standard:Panel>
    <Properties><Alignment>1</Alignment><Bounds><Width>180</Width></Bounds></Properties>
    <Standard:Button>
      <Properties>
        <Caption>Clock</Caption>
        <Alignment>2</Alignment>
        <OnClickHandler>X Run</OnClickHandler>
      </Properties>
      <Standard:SystemCommand>
        <Properties><ID>X</ID>
          <CommandString>WMClock.Open</CommandString>
        </Properties>
      </Standard:SystemCommand>
    </Standard:Button>
    <Standard:Button>
      <Properties>
        <Caption>Calendar</Caption>
        <Alignment>2</Alignment>
        <OnClickHandler>X Run</OnClickHandler>
      </Properties>
      <Standard:SystemCommand>
        <Properties><ID>X</ID>
          <CommandString>WMCalendar.Open</CommandString>
        </Properties>
      </Standard:SystemCommand>
    </Standard:Button>
  </Standard:Panel>
  <Standard:Panel>
    <Properties><Alignment>1</Alignment><Bounds><Width>180</Width></Bounds></Properties>
    <Standard:Button>
      <Properties><Caption>Task scheduler</Caption><Alignment>2</Alignment><OnClickHandler>X Run</OnClickHandler></Properties>
      <Standard:SystemCommand><Properties><ID>X</ID><CommandString>WMTaskScheduler.Open</CommandString></Properties></Standard:SystemCommand>
    </Standard:Button>
    <Standard:Button>
      <Properties><Caption>Performance</Caption><Alignment>2</Alignment><OnClickHandler>X Run</OnClickHandler></Properties>
      <Standard:SystemCommand><Properties><ID>X</ID><CommandString>WMPerfMon.Open</CommandString></Properties></Standard:SystemCommand>
    </Standard:Button>
  </Standard:Panel>
</Standard:Panel>
