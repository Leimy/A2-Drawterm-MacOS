<Standard:Panel caption=" Graphics ">
  <Properties><FillColor>0</FillColor></Properties>
  <Standard:Panel>
    <Properties><Alignment>1</Alignment><Bounds><Width>180</Width></Bounds></Properties>
    <Standard:Button>
      <Properties><Caption>Image viewer</Caption><Alignment>2</Alignment><OnClickHandler>X Run</OnClickHandler></Properties>
      <Standard:SystemCommand><Properties><ID>X</ID><CommandString>WMPicView.Open mars.png</CommandString></Properties></Standard:SystemCommand>
    </Standard:Button>
    <Standard:Button>
      <Properties><Caption>Graph demos</Caption><Alignment>2</Alignment><OnClickHandler>X Run</OnClickHandler></Properties>
      <Standard:SystemCommand><Properties><ID>X</ID><CommandString>WMSimpleGraphs.Demo</CommandString></Properties></Standard:SystemCommand>
    </Standard:Button>
  </Standard:Panel>
  <Standard:Panel>
    <Properties><Alignment>1</Alignment><Bounds><Width>180</Width></Bounds></Properties>
    <Standard:Button>
      <Properties><Caption>Drawing overlay</Caption><Alignment>2</Alignment><OnClickHandler>X Run</OnClickHandler></Properties>
      <Standard:SystemCommand><Properties><ID>X</ID><CommandString>WMOverlay.Open</CommandString></Properties></Standard:SystemCommand>
    </Standard:Button>
    <Standard:Button>
      <Properties><Caption>On-screen message</Caption><Alignment>2</Alignment><OnClickHandler>X Run</OnClickHandler></Properties>
      <Standard:SystemCommand><Properties><ID>X</ID><CommandString>WMOSD.Open A2-ready 6000</CommandString></Properties></Standard:SystemCommand>
    </Standard:Button>
  </Standard:Panel>
  <Standard:Panel>
    <Properties><Alignment>1</Alignment><Bounds><Width>180</Width></Bounds></Properties>
    <Standard:Button>
      <Properties><Caption>Module state</Caption><Alignment>2</Alignment><OnClickHandler>X Run</OnClickHandler></Properties>
      <Standard:SystemCommand><Properties><ID>X</ID><CommandString>WMModuleState.Open WindowManager</CommandString></Properties></Standard:SystemCommand>
    </Standard:Button>
    <Standard:Button>
      <Properties><Caption>Backdrops</Caption><Alignment>2</Alignment><OnClickHandler>X Run</OnClickHandler></Properties>
      <Standard:SystemCommand><Properties><ID>X</ID><CommandString>WMBackdropLoader.Open BackdropList.XML</CommandString></Properties></Standard:SystemCommand>
    </Standard:Button>
  </Standard:Panel>
  <Standard:Panel>
    <Properties><Alignment>1</Alignment><Bounds><Width>180</Width></Bounds></Properties>
    <Standard:Button>
      <Properties><Caption>Gfx spiral</Caption><Alignment>2</Alignment><OnClickHandler>X Run</OnClickHandler></Properties>
      <Standard:SystemCommand><Properties><ID>X</ID><CommandString>WMGraphicsDemo.TestGfx</CommandString></Properties></Standard:SystemCommand>
    </Standard:Button>
    <Standard:Button>
      <Properties><Caption>Slideshow</Caption><Alignment>2</Alignment><OnClickHandler>X Run</OnClickHandler></Properties>
      <Standard:SystemCommand><Properties><ID>X</ID><CommandString>WMSlideshow.Open RetoWMSlideshow.XML</CommandString></Properties></Standard:SystemCommand>
    </Standard:Button>
