<Standard:Panel caption=" Desktop ">
  <Properties><FillColor>0</FillColor></Properties>
  <Standard:Panel>
    <Properties><Alignment>1</Alignment><Bounds><Width>180</Width></Bounds></Properties>
    <Standard:Button>
      <Properties>
        <Caption>Notepad</Caption>
        <Alignment>2</Alignment>
        <OnClickHandler>X Run</OnClickHandler>
      </Properties>
      <Standard:SystemCommand>
        <Properties><ID>X</ID>
          <CommandString>Notepad.Open</CommandString>
        </Properties>
      </Standard:SystemCommand>
    </Standard:Button>
    <Standard:Button>
      <Properties>
        <Caption>Tetris</Caption>
        <Alignment>2</Alignment>
        <OnClickHandler>X Run</OnClickHandler>
      </Properties>
      <Standard:SystemCommand>
        <Properties><ID>X</ID>
          <CommandString>WMTetris.Open</CommandString>
        </Properties>
      </Standard:SystemCommand>
    </Standard:Button>
  </Standard:Panel>
  <Standard:Panel>
    <Properties><Alignment>1</Alignment><Bounds><Width>180</Width></Bounds></Properties>
    <Standard:Button>
      <Properties>
        <Caption>Files</Caption>
        <Alignment>2</Alignment>
        <OnClickHandler>X Run</OnClickHandler>
      </Properties>
      <Standard:SystemCommand>
        <Properties><ID>X</ID>
          <CommandString>WMFileManager.Open</CommandString>
        </Properties>
      </Standard:SystemCommand>
    </Standard:Button>
    <Standard:Button>
      <Properties>
        <Caption>BlueShell</Caption>
        <Alignment>2</Alignment>
        <OnClickHandler>X Run</OnClickHandler>
      </Properties>
      <Standard:SystemCommand>
        <Properties><ID>X</ID>
          <CommandString>WMShell.Open</CommandString>
        </Properties>
      </Standard:SystemCommand>
    </Standard:Button>
  </Standard:Panel>
  <Standard:Panel>
    <Properties><Alignment>1</Alignment><Bounds><Width>180</Width></Bounds></Properties>
    <Standard:Button>
      <Properties>
        <Caption>Kernel log</Caption>
        <Alignment>2</Alignment>
        <OnClickHandler>X Run</OnClickHandler>
      </Properties>
      <Standard:SystemCommand>
        <Properties><ID>X</ID>
          <CommandString>WMKernelLog.Open</CommandString>
        </Properties>
      </Standard:SystemCommand>
    </Standard:Button>
    <Standard:Button>
      <Properties>
        <Caption>Shutdown</Caption>
        <Alignment>2</Alignment>
        <OnClickHandler>X Run</OnClickHandler>
      </Properties>
      <Standard:SystemCommand>
        <Properties><ID>X</ID>
          <CommandString>System.PowerDown</CommandString>
        </Properties>
      </Standard:SystemCommand>
    </Standard:Button>
  </Standard:Panel>
</Standard:Panel>
